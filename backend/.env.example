# ==============================================================================
# Cartify Backend Environment Variables (Module 0 Foundation)
# Copy this file to .env for local development
# NEVER commit .env with real credentials or production secrets to source control
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
DEBUG=true

# PostgreSQL Primary Database (AsyncPG Driver)
DATABASE_URL=postgresql+asyncpg://cartify:cartify_secure_pass@localhost:5432/cartify_db

# PostgreSQL Read Replica Database (Optional - defaults to DATABASE_URL if omitted)
DATABASE_REPLICA_URL=postgresql+asyncpg://cartify:cartify_secure_pass@localhost:5432/cartify_db

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_ECHO=false
DB_TIMEOUT_SECONDS=5.0

# Redis Cache & Stampede Lock URL
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_MAX_CONNECTIONS=100
REDIS_SOCKET_TIMEOUT=2.0
REDIS_CONNECT_TIMEOUT=2.0
REDIS_TIMEOUT_SECONDS=2.0

# Cross-Origin Resource Sharing (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security & Tokens (Foundation for Module 1)
SECRET_KEY=change_this_to_a_secure_random_string_in_production_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server-side Request Timeout & Rate Limits
REQUEST_TIMEOUT_SECONDS=10.0
RATE_LIMIT_PER_MINUTE=120

# Module 12 Payments & High-Security Infrastructure
PAYMENT_PROVIDER_DEFAULT=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_MAX_BYTES=65536
PAYMENT_EXPIRY_MINUTES=15

# Module 13 Notifications & Infrastructure
NOTIFICATION_EMAIL_PROVIDER=mock
NOTIFICATION_EMAIL_API_KEY=
NOTIFICATION_SMS_PROVIDER=mock
NOTIFICATION_SMS_API_KEY=
NOTIFICATION_PUSH_PROVIDER=mock
NOTIFICATION_PUSH_API_KEY=
NOTIFICATION_WEBHOOK_SECRET=
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_DELAY=5
NOTIFICATION_DEFAULT_EXPIRY_DAYS=90
