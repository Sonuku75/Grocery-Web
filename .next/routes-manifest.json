{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/categories/[slug]",
      "regex": "^/categories/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/categories/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/order-confirmation/[id]",
      "regex": "^/order\\-confirmation/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
