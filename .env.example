# Cartify Frontend Public Configuration
# Base URL for the Python FastAPI Backend REST API (Module 0+)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Frontend Application Metadata
NEXT_PUBLIC_APP_NAME=Cartify
NEXT_PUBLIC_APP_TAGLINE=Fresh Groceries & Essentials in Minutes

# Development Mock Toggle
# Set to 'true' to use client-side mock data fallback if backend is offline
# Set to 'false' to communicate exclusively with the live FastAPI backend
NEXT_PUBLIC_USE_MOCK=true
